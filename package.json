{
  "name": "examos",
  "version": "0.1.0",
  "private": true,
  "description": "ExamOS \u2014 an exam readiness system that measures how prepared you actually are and tells you what to do next.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "desktop:dev": "node scripts/copy-wasm.mjs && electron electron/main.cjs",
    "desktop:pack": "npm run build && electron-builder --win nsis --publish never",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "jose": "^6.1.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "next": "^16.3.5",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sql.js": "^1.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3"
  }
}
