{
  "name": "examos",
  "version": "0.1.0",
  "private": true,
  "description": "ExamOS \u2014 an exam readiness system that measures how prepared you actually are and tells you what to do next.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-wasm.mjs && node scripts/make-icon.mjs",
    "build": "next build && node scripts/postbuild.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "desktop:dev": "npm run build && electron electron/main.cjs",
    "test:e2e": "playwright test",
    "desktop:win": "npm run build && electron-builder --win nsis --publish never",
    "desktop:mac": "npm run build && electron-builder --mac dmg --publish never",
    "desktop:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "seed:demo": "node scripts/seed-demo.mjs",
    "pretest": "tsc -p tsconfig.test.json && node scripts/fix-test-imports.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "jose": "^6.1.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.11.0",
    "next": "^16.3.5",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sql.js": "^1.13.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sql.js": "^1.4.9",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.3"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.examos.app",
    "productName": "ExamOS",
    "copyright": "ExamOS",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-server",
        "filter": [
          "**/*",
          "!data",
          "!data/**",
          "!.test-data",
          "!.test-data/**",
          "!**/*.sqlite*"
        ]
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "ExamOS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ExamOS",
      "include": "electron/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "ExamOS-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Education",
      "artifactName": "ExamOS-${version}.${ext}"
    }
  },
  "author": {
    "name": "ExamOS"
  }
}
