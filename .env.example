# ---------------------------------------------------------------------------
# ExamOS configuration
# ---------------------------------------------------------------------------

# Which AI provider to use: anthropic or gemini. Optional — setting it here
# fixes the choice for this installation and removes it from the Settings page.
# Left empty, the app uses whichever provider you pick in Settings, or the one
# that has a key.
EXAMOS_PROVIDER=

# A key for the provider you use. Required for every AI-backed feature (course
# analysis, exam generation, answer evaluation, scan reading, study material).
# Without one the app still runs, but AI features refuse with a clear message
# instead of inventing content.
#
# Anthropic keys: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Gemini keys: https://aistudio.google.com/apikey  (GOOGLE_API_KEY also works)
#
# Note on Gemini's free tier: Google states that free-tier content is used to
# improve their products, which can include human review. Do not use a free key
# for material your university treats as confidential.
GEMINI_API_KEY=

# Model used for all structured AI workflows, per provider. Optional; each
# provider has a current default. EXAMOS_MODEL still works and applies to
# whichever provider its value names.
EXAMOS_MODEL_ANTHROPIC=
EXAMOS_MODEL_GEMINI=

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a secret is generated once and stored in the data directory.
EXAMOS_SESSION_SECRET=

# Where the SQLite database and uploaded files live.
# Defaults to ./data in development and to the OS app-data folder in the
# packaged desktop build.
EXAMOS_DATA_DIR=

# Optional: absolute path to sql-wasm.wasm. Normally resolved automatically.
EXAMOS_SQL_WASM=
