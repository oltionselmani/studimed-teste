# ---------------------------------------------------------------------------
# ExamOS configuration
# ---------------------------------------------------------------------------

# Required for every AI-backed feature (course analysis, exam generation,
# answer evaluation, scan reading, study material).
# Without it the app still runs, but AI features refuse with a clear message
# instead of inventing content.
ANTHROPIC_API_KEY=

# Model used for all structured AI workflows.
EXAMOS_MODEL=claude-opus-5

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If unset, a secret is generated once and stored in the data directory.
EXAMOS_SESSION_SECRET=

# Where the SQLite database and uploaded files live.
# Defaults to ./data in development and to the OS app-data folder in the
# packaged desktop build.
EXAMOS_DATA_DIR=

# Optional: absolute path to sql-wasm.wasm. Normally resolved automatically.
EXAMOS_SQL_WASM=
